# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM — elige proveedor: anthropic | groq | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Groq (gratis) → https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama (local, gratis) → https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Asistente
ASSISTANT_NAME=Yarbis
WAKE_WORD=Yarbis
USER_NAME=Michel
TIMEZONE=America/Bogota
MAX_HISTORY=40

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8002/auth/google/callback

# App
APP_SECRET_KEY=change_this_to_a_random_secret
FRONTEND_URL=http://localhost:5173
PLUGINS_DIR=backend/plugins
